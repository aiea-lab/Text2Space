{
  "model": {
    "model_name": "Qwen/Qwen3-30B-A3B-Instruct-2507",
    "use_peft": true,
    "use_flash_attention": false,
    "lora_r": 16,
    "lora_alpha": 32
  },
  "data": {
    "data_path": "datasets/spatial_data_untested.jsonl",
    "task": "B",
    "ascii_view": "grid",
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "max_samples": 5000,
    "prompt_completion_format": true
  },
  "training": {
    "num_epochs": 1,
    "batch_size": 8,
    "gradient_accumulation_steps": 2,
    "learning_rate": 2e-4,
    "output_dir": "saved_models/task_b_completion_only_fine_tune",
    "save_strategy": "steps",
    "save_steps": 200,
    "eval_steps": 200,
    "completion_only_loss": true
  }
}
