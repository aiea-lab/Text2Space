{
  "model": {
    "model_name": "meta-llama/Meta-Llama-3-70B-Instruct",
    "use_peft": true,
    "use_flash_attention": true,
    "load_in_8bit": true,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]
  },
  "data": {
    "data_path": "datasets/spatial_data_untested.jsonl",
    "task": "mixed",
    "ascii_view": "grid",
    "train_split": 0.8,
    "val_split": 0.1,
    "test_split": 0.1,
    "max_samples": 5000,
    "max_seq_length": 2048,
    "prompt_completion_format": true
  },
  "training": {
    "num_epochs": 1,
    "batch_size": 2,
    "gradient_accumulation_steps": 8,
    "learning_rate": 1e-4,
    "warmup_steps": 200,
    "optimizer": "paged_adamw_8bit",
    "gradient_checkpointing": true,
    "packing": true,
    "output_dir": "saved_models/task_mixed_llama70b_completion_only",
    "save_strategy": "steps",
    "save_steps": 200,
    "eval_steps": 200,
    "completion_only_loss": true
  }
}
